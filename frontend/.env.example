# FaceVote Frontend Environment Configuration Template

# Backend API Endpoint URL (Local dev: http://127.0.0.1:8000 | Production: https://your-backend.render.com)
VITE_API_URL=http://127.0.0.1:8000

# Supabase Public Configuration (Optional for client-side queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_here
