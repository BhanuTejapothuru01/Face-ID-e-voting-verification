# FaceVote Backend Environment Configuration Template

# Server Port & Allowed CORS Origins (Comma-separated)
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Administrative Passcode for Admin Dashboard Access
ADMIN_SECRET=your_admin_secret_passcode_here

# Biometric Cosine Similarity Threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.68
USE_SQLITE=true

# Quality & Biometric Filtering Settings
FACE_MIN_SIZE=100
FACE_MIN_DETECTION_SCORE=0.6
BLUR_THRESHOLD=45.0
BRIGHTNESS_MIN=35.0
BRIGHTNESS_MAX=225.0
MAX_POSE_ANGLE=25.0

# Multi-Template & Verification Tuning
TOP_K_SEARCH=5
MIN_MATCHING_FRAMES=3
MAX_TEMPLATES_PER_VOTER=10
OUTLIER_DISTANCE_THRESHOLD=0.45

# Verification Candidate Scoring Weights
WEIGHT_BEST_SIM=0.50
WEIGHT_TOP_K_AVG=0.30
WEIGHT_TEMPORAL_CONSISTENCY=0.20

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_jwt_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt_here
